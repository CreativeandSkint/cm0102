+int KSystem::clearAllOpCaches() {
+    int count = 0;
+    std::vector<KMemory*> done;
+    for (auto& n : KSystem::processes) {
+        const KProcessPtr& process = n.value;
+        if (!process || process->terminated || !process->memory) {
+            continue;
+        }
+        bool seen = false;
+        for (KMemory* m : done) {
+            if (m == process->memory) {
+                seen = true;
+                break;
+            }
+        }
+        if (seen) {
+            continue;
+        }
+        done.push_back(process->memory);
+        process->memory->clearOpCache();
+        count++;
+    }
+    return count;
+}
